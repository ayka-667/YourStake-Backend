# YourStake backend - example configuration
#
# Copy this file to config/config.env for local development:
#   cp config/config.example.env config/config.env
#
# On Vercel, do NOT upload this file: add every variable in
# Project Settings -> Environment Variables instead.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=production

# MongoDB connection string. On Vercel, use a hosted cluster (MongoDB Atlas
# recommended) reachable from the internet; localhost will not work.
DATABASE_URI=mongodb://user:password@host:27017/yourstake?authSource=yourstake

# Public URL(s) of the frontend, comma separated. Used for CORS and e-mails.
SERVER_FRONTEND_URL=https://yourstake.fr

# Public URL of this backend (used by payment callbacks)
SERVER_BACKEND_URL=https://yourstake-backend.vercel.app

# Port used by the local/long-running server only (ignored on Vercel)
SERVER_PORT=5001

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TOKEN_SECRET=change-me-with-a-long-random-string
TOKEN_EXPIRE=1w

# hCaptcha secret (the site key lives in the frontend)
CAPTCHA_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# E-mail (nodemailer)
# ---------------------------------------------------------------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@yourstake.fr
EMAIL_FROM_NAME=YourStake

# ---------------------------------------------------------------------------
# Game limits
# ---------------------------------------------------------------------------
BLACKJACK_TABLES_STANDARD=100
BLACKJACK_TABLES_WHALE=50
BLACKJACK_DECK_COUNT=10
BLACKJACK_MIN_AMOUNT_STANDARD=0.01
BLACKJACK_MIN_AMOUNT_WHALE=10
BLACKJACK_MAX_AMOUNT_STANDARD=1000
BLACKJACK_MAX_AMOUNT_WHALE=100000

ROLL_MIN_AMOUNT=0.01
ROLL_MAX_AMOUNT=100000
ROLL_MAX_PROFIT=1000000

CRASH_MIN_AMOUNT=0.01
CRASH_MAX_AMOUNT=100000
CRASH_MAX_PROFIT=1000000

MINES_MIN_AMOUNT=0.01
MINES_MAX_AMOUNT=100000

TOWERS_MIN_AMOUNT=0.01
TOWERS_MAX_AMOUNT=100000

DUELS_MIN_AMOUNT=0.01
DUELS_MAX_AMOUNT=100000

UPGRADER_MIN_AMOUNT=0.01

RAIN_MIN_HOST_AMOUNT=10
RAIN_MIN_TIP_AMOUNT=1
AFFILIATE_MIN_CLAIM=1

# ---------------------------------------------------------------------------
# Deposits / withdrawals
# ---------------------------------------------------------------------------
COINPAYMENTS_MERCHANT=
COINPAYMENTS_API_KEY=
COINPAYMENTS_SECRET=
COINPAYMENTS_PRIVATE_KEY=

ZEBRASMARKET_PARTNER=
ZEBRASMARKET_API_KEY=
CREDIT_MIN_AMOUNT=1

SKINIFY_API_KEY=

# ---------------------------------------------------------------------------
# Fake players - local / long-running server only (never on Vercel)
# ---------------------------------------------------------------------------
BOTS_ENABLED=false
BOTS_COUNT=100
BOTS_WHALES=5
BOTS_DEBUG=false

# Optional path to a Chrome/Chromium binary for the credit cashier
CHROME_PATH=
